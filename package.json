{
  "name": "sort-keys-recursive",
  "description": "Sort object keys recursively for deterministic JSON serialization and stable hashing.",
  "homepage": "https://github.com/Kikobeats/sort-keys-recursive",
  "version": "2.1.10",
  "main": "./index.js",
  "author": {
    "email": "josefrancisco.verdu@gmail.com",
    "name": "Kiko Beats",
    "url": "https://github.com/Kikobeats"
  },
  "contributors": [
    {
      "name": "mitogh",
      "email": "mitogh@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikobeats/sort-keys-recursive.git"
  },
  "bugs": {
    "url": "https://github.com/Kikobeats/sort-keys-recursive/issues"
  },
  "keywords": [
    "deep",
    "deterministic",
    "hash",
    "json",
    "keys",
    "object",
    "recursive",
    "serialize",
    "sort",
    "stable"
  ],
  "dependencies": {
    "kind-of": "~6.0.2",
    "sort-keys": "~4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "ava": "latest",
    "c8": "latest",
    "ci-publish": "latest",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "github-generate-release": "latest",
    "nano-staged": "latest",
    "simple-git-hooks": "latest",
    "standard": "latest",
    "standard-markdown": "latest",
    "standard-version": "latest"
  },
  "engines": {
    "node": ">=4"
  },
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "contributors": "(npx git-authors-cli && npx finepack && git add package.json && git commit -m 'build: contributors' --no-verify) || true",
    "lint": "standard-markdown && standard",
    "postrelease": "npm run release:tags && npm run release:github && (ci-publish || npm publish --access=public)",
    "prerelease": "npm run contributors",
    "pretest": "npm run lint",
    "release": "standard-version -a",
    "release:github": "github-generate-release",
    "release:tags": "git push --follow-tags origin HEAD:master",
    "test": "c8 ava"
  },
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "nano-staged": {
    "*.js": [
      "npx @kikobeats/prettier-standard",
      "standard --fix"
    ],
    "*.md": [
      "standard-markdown"
    ],
    "package.json": [
      "finepack"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  }
}
